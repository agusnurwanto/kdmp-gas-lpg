# URL Web App Google Apps Script yang telah di-deploy (Deploy -> New Deployment -> Web App)
# Pastikan Access diatur ke "Anyone"
GAS_WEBAPP_URL=https://script.google.com/macros/s/AKfycbxXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/exec

# API Secret Key yang disetel pada Script Properties di Google Apps Script (Project Settings -> Script Properties -> API_SECRET_KEY)
GAS_API_KEY=ganti_dengan_secret_key_anda
